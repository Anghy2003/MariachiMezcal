{
  "name": "mezcal-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply mezcal --local",
    "db:migrate:remote": "wrangler d1 migrations apply mezcal --remote",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "typescript": "~5.9.2",
    "wrangler": "^4.145.0"
  }
}
